# Keycloak visto desde el navegador: <gateway>/auth
NEXT_PUBLIC_AUTH_URL=http://localhost:8080/auth
NEXT_PUBLIC_AUTH_REALM=ruta-salud
NEXT_PUBLIC_AUTH_CLIENT_ID=web-ruta-salud
